# Build context is the backend/ module root.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/traegod ./cmd/traegod

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/traegod /traegod
ENTRYPOINT ["/traegod"]
