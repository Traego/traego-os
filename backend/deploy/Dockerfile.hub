# Build context is backend/ (the Go module root). The hub is API-only for now;
# its wizard UI will get its own stage the way the controller embeds the SPA.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/hub ./cmd/hub

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/hub /hub
# Cloud Run injects $PORT; local/self-hosted defaults to :9443.
EXPOSE 9443
ENTRYPOINT ["/hub"]
